{
  "compilerOptions": {
    "lib": ["dom", "es2022"],
    "types": ["vite/client"],
    "target": "es6",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "module": "es2015",
    "declaration": true,
    "moduleResolution": "bundler",
    "outDir": "./lib",
    "noEmitOnError": false,
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "lib/",
    "**/*.stories.tsx",
    "__tests__/"
  ],
  "references": [
    // { "path": "../SERVICE_NAME" }
  ]
}
