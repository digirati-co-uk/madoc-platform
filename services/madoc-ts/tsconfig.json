{
  "compilerOptions": {
    "experimentalDecorators": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["dom", "es2022"],
    "types": ["node", "vite/client"],
    "target": "esnext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "module": "esnext",
    "declaration": false,
    "moduleResolution": "bundler",
    "outDir": "./lib",
    "noEmitOnError": false,
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": [
    "node_modules",
    "lib/",
    "test-utility/",
    "fixtures/",
    "stories/",
    "**/*.stories.tsx",
    "__tests__/",
    "npm"
  ],
  "references": [
    // { "path": "../SERVICE_NAME" }
  ]
}
