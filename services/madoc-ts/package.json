  "name": "madoc-ts",
  "version": "1.0.0",
  "main": "lib/index.js",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "license": "MIT",
  "author": "Stephen Fraser <stephen.fraser@digirati.com>",
  "scripts": {
    "dev": "NODE_ENV=development pm2 start ecosystem.config.cjs --no-daemon --wait-ready",
    "storybook": "storybook dev -p 6500",
    "test": "jest",
    "test-storybook": "test-storybook --url http://localhost:6500 --maxWorkers 1",
    "build": "concurrently \"pnpm run generate-schema\" \"pnpm run build:vite\" \"pnpm run build:frontend\" \"pnpm run shim-modules\"",
    "dev:vite": "vite --config vite/vite.dev-server.js --host",
    "start": "concurrently \"pnpm run watch:vite-producer\" \"pnpm run watch:vite-auth\" \"pnpm run watch:vite-server\" \"pnpm run watch:vite-scheduler\"",
    "build:vite": "concurrently \"pnpm run build:vite-producer\" \"pnpm run build:vite-auth\" \"pnpm run build:vite-server\" \"pnpm run build:vite-scheduler\"",
    "build:vite-producer": "vite build --config vite/vite.producer.js .",
    "build:vite-auth": "vite build --config vite/vite.auth.js .",
    "build:vite-server": "NODE_OPTIONS=--max-old-space-size=4096 vite build --config vite/vite.server.js .",
    "build:vite-scheduler": "vite build --config vite/vite.scheduler.js .",
    "build-storybook": "storybook build",
    "watch:vite": "pnpm run build:vite-producer && pnpm run build:vite-auth && pnpm run build:vite-server && pnpm run build:vite-scheduler --watch",
    "watch:vite-producer": "vite build --config vite/vite.producer.js . --watch",
    "watch:vite-auth": "vite build --config vite/vite.auth.js . --watch",
    "watch:vite-server": "vite build --config vite/vite.server.js . --watch",
    "watch:vite-scheduler": "vite build --config vite/vite.scheduler.js . --watch",
    "generate-migration": "node migrate.cjs create",
    "generate:icon-story": "node tools/generate-icon-story.mjs",
    "docs:screenshot": "node tools/documentation.mjs",
    "generate-schema": "node generate-schemas.js",
    "build:frontend": "NODE_OPTIONS=--max-old-space-size=4096 NODE_ENV=production vite build --config vite/vite.frontend.js",
    "link:model-editor": "pnpm link --global \"@capture-models/editor\"",
    "unlink:model-editor": "pnpm unlink --global \"@capture-models/editor\" && pnpm install --force",
    "link:model-helpers": "pnpm link --global \"@capture-models/helpers\"",
    "unlink:model-helpers": "pnpm unlink --global \"@capture-models/helpers\" && pnpm install --force",
    "shim-modules": "if [ -d ./shim-modules/node_modules ]; then rm -rf ./dist/node_modules && cp -R ./shim-modules/node_modules ./dist/node_modules; else echo \"shim-modules/node_modules not present; skipping\"; fi",
    "extract:api": "tsc -p ./tsconfig.types.json"
  },
  "browserslist": "> 0.25%, not dead",
